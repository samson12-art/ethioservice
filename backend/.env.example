# Server
PORT=5000
NODE_ENV=production

# Database (Supabase)
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# Individual DB vars (used locally)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ethioservice
DB_USER=postgres
DB_PASSWORD=your_password_here

# Authentication
JWT_SECRET=your_strong_random_secret_here
JWT_EXPIRE=30d

# CORS (your Vercel frontend URL)
CORS_ORIGIN=https://your-app.vercel.app

# Payment - Chapa
CHAPA_SECRET_KEY=your_chapa_secret_key
CHAPA_PUBLIC_KEY=your_chapa_public_key
CHAPA_BASE_URL=https://api.chapa.co

# Payment - Telebirr
TELEBIRR_APP_ID=your_telebirr_app_id
TELEBIRR_APP_KEY=your_telebirr_app_key
TELEBIRR_SHORT_CODE=your_short_code
TELEBIRR_PUBLIC_KEY=your_telebirr_public_key
TELEBIRR_RECEIVE_NAME=your_receive_name
TELEBIRR_ENDPOINT_URL=your_endpoint_url
